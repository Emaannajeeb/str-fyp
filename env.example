# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streamflow_payroll?schema=public"

# Application
NODE_ENV=development
APP_BASE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_TO_SECURE_RANDOM_32_CHARS_MIN"
JWT_SECRET="CHANGE_ME_TO_SECURE_RANDOM_32_CHARS_MIN"
ENCRYPTION_KEY_32B="CHANGE_ME_TO_32_BYTE_BASE64"

# Solana / Streamflow Configuration
# Solana RPC endpoint URL (required for Streamflow SDK)
SOLANA_CLUSTER_URL="https://api.devnet.solana.com"
# Client-side Solana RPC URL (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SOLANA_CLUSTER_URL="https://api.devnet.solana.com"
# Solana cluster name: mainnet-beta, devnet, or testnet
SOLANA_CLUSTER="devnet"
# Client-side cluster name (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"
# Solana Explorer base URL
SOLANA_EXPLORER_BASE="https://explorer.solana.com"
# Enable real Streamflow SDK calls (set to true for devnet/production)
STREAMFLOW_ENABLED=true

# Wallet Configuration
# Allow mock wallet provider (for development/testing only)
# Set to false in production to disable mock wallet
WALLET_ALLOW_MOCK=false
# Client-side flag (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_WALLET_ALLOW_MOCK=false

# Optional: Private key for server-side wallet operations (base58 encoded)
# Only needed if you want server-side stream creation/cancellation
# STREAMFLOW_SENDER_PRIVATE_KEY="your-private-key-here"

