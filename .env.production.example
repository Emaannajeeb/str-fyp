# Production Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: Rotate all secrets regularly (JWT_SECRET, NEXTAUTH_SECRET, STREAMFLOW_WEBHOOK_SECRET, ENCRYPTION_KEY_32B)

# Database
DATABASE_URL=postgresql://user:password@postgres:5432/streamflow_payroll

# Application URLs
NEXTAUTH_URL=https://your-domain.com
APP_BASE_URL=https://your-domain.com

# Secrets (ROTATE REGULARLY - Generate new values every 90 days)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-rotate-regularly
JWT_SECRET=your-jwt-secret-min-32-chars-rotate-regularly

# Solana Configuration
SOLANA_CLUSTER=mainnet-beta
# Options: mainnet-beta, devnet, testnet

# Streamflow API
STREAMFLOW_API_BASE=https://api.streamflow.finance
STREAMFLOW_WEBHOOK_SECRET=your-webhook-secret-rotate-regularly
STREAMFLOW_ENABLED=true

# Encryption Key (ROTATE REGULARLY - Generate new value every 90 days)
# Generate with: openssl rand -base64 32
# WARNING: Rotating this will require re-encrypting all encrypted data
ENCRYPTION_KEY_32B=your-base64-encoded-32-byte-key-rotate-regularly

# Optional: Wallet Configuration
WALLET_ALLOW_MOCK=false

# Optional: Upstash Redis (for rate limiting in production)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Optional: Worker Health Check Port
WORKER_HEALTH_PORT=3001
